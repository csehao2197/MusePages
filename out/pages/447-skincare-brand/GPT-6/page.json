{
    "title": "Oda — Less, but better for skin",
    "tags": ["Skincare", "Clay & Cream", "Quiet Editorial"],
    "mocks": "Original bottle and clay illustrations replace requested photography; static HTML adaptation of React brief. Product notes replace separate commerce routes. Reviews and ingredient claims are supplied concept copy, not verified evidence. Newsletter does not transmit or persist data; accounts, bag and refills are explanatory.",
    "tests": [
        { "selector": ".products > a", "count": 5 },
        { "selector": ".products > a:first-child", "click": true },
        { "selector": "#product", "visible": true },
        { "selector": "#product-title", "text": "Clay Cleanser" },
        { "selector": "#product-price", "text": "£22" },
        { "selector": ".close", "click": true },
        { "selector": "#product", "visible": false },
        { "selector": "#email", "fill": "", "valid": false },
        { "selector": "#email", "fill": "wrong", "valid": false },
        { "selector": "#email", "fill": "reader@example.test", "valid": true },
        { "selector": "#newsletter button", "click": true },
        { "selector": "#email-status", "text": "Nothing was sent" },
        { "selector": "#journal article:first-child summary", "click": true },
        { "selector": "#journal article:first-child details p", "text": "general brand editorial" }
    ]
}
